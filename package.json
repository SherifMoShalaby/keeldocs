{
  "name": "keeldocs",
  "version": "0.2.0-rc.2",
  "description": "keeldocs - test coverage for your docs: anchors doc sections to the code they describe, deterministically flags drift with receipts, proposes reviewable patches. Any stack, any agent, no SaaS.",
  "keywords": [
    "documentation",
    "docs",
    "drift",
    "living-documentation",
    "ci",
    "agent-skills",
    "deterministic"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "keeldocs": "bin/keeldocs.js"
  },
  "files": [
    "bin/",
    "src/",
    "providers/",
    "recipes/",
    "skills/",
    "adapters/",
    "spec/",
    "action.yml",
    "scripts/sarif.js",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && python3 scripts/harness.py",
    "smoke": "node bin/keeldocs.js sync --json; test $? -eq 2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SherifMoShalaby/keeldocs.git"
  },
  "homepage": "https://github.com/SherifMoShalaby/keeldocs#readme",
  "bugs": {
    "url": "https://github.com/SherifMoShalaby/keeldocs/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "0.5.4"
  }
}
